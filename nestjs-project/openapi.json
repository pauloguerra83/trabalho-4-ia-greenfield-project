      "delete": {
        "description": "Aborts the multipart upload in the storage and marks the video as failed (upload_aborted).",
        "operationId": "VideosController_abortUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Upload aborted"
          },
          "400": {
            "description": "Invalid id (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or owned by another user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not a draft (INVALID_VIDEO_STATUS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Abort the upload",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "StartUploadDto": {
        "type": "object",
        "properties": {}
      },
      "StartUploadResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadId": {
            "type": "string",
            "description": "Multipart upload id in the storage"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "Minha aula"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft"
            ],
            "example": "draft"
          },
          "partSize": {
            "type": "number",
            "example": 67108864,
            "description": "Part size in bytes"
          },
          "partCount": {
            "type": "number",
            "example": 3,
            "description": "Number of parts to upload"
          }
        },
        "required": [
          "videoId",
          "uploadId",
          "slug",
          "title",
          "status",
          "partSize",
          "partCount"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "Minha aula"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true,
            "example": 3
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "description": "Curated ffprobe summary with `format`, `video` and `audio` (null without audio)",
            "additionalProperties": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET URL of the JPEG thumbnail (valid for 1 hour)"
          },
          "processingError": {
            "type": "string",
            "nullable": true,
            "example": null,
            "description": "Failure reason when status is failed (e.g. upload_expired, invalid_video)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "durationSeconds",
          "metadata",
          "thumbnailUrl",
          "processingError",
          "createdAt",
          "updatedAt"
        ]
      },
      "VideoUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GET URL served by the storage"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the URL expires"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "PartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned URL for a PUT straight to the storage"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the URLs expire"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "ETag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          },
          "size": {
            "type": "number",
            "example": 67108864,
            "description": "Part size in bytes"
          }
        },
        "required": [
          "partNumber",
          "ETag",
          "size"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "partSize": {
            "type": "number",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 3
          },
          "parts": {
            "description": "Parts already received by the storage, by ascending number",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "uploadId",
          "partSize",
          "partCount",
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing"
            ],
            "example": "processing"
          }
        },
        "required": [
          "videoId",
          "status"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}